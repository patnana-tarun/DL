# ---------------------------------------------------------------------------
# Secrets: never commit (MediaMTX TLS key/cert are generated per machine)
# ---------------------------------------------------------------------------
*.key
*.crt
*.pem
.env
.env.*

# ---------------------------------------------------------------------------
# Python / tooling
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Editor state
.vscode/
.idea/
.DS_Store

# ---------------------------------------------------------------------------
# Large inputs (see README "Data and weights")
# ---------------------------------------------------------------------------
videos/
# datasets: keep only the small stats files that paper/make_numbers.py reads
datasets/*
!datasets/stats.json
!datasets/test1/
datasets/test1/*
!datasets/test1/stats.json
!datasets/scene_v1/
datasets/scene_v1/*
!datasets/scene_v1/stats.json
!datasets/scene_v2/
datasets/scene_v2/*
!datasets/scene_v2/stats.json
*.mp4
*.avi
*.mkv
*.zip
*.parquet

# Weights and training runs (selected detector ships as ONNX in edge_deploy/models/)
runs/
weights/
models/pretrained/
*.pt
*.pth
*.safetensors
*.engine
*.gguf

# Edge runtime: downloaded / built binaries and runtime state
edge_deploy/models/vlm/
edge_deploy/third_party/
edge_deploy/tools/bin/
edge_deploy/data/*
!edge_deploy/data/.gitkeep

# ---------------------------------------------------------------------------
# Results: keep metrics/figures, drop bulky regenerable dumps
# ---------------------------------------------------------------------------
results/**/preds/
results/**/*.npz
results/**/*.db
results/logs/revision/
results/campus/*/crops/

# Images of people (privacy): annotation frames and every figure drawn over video frames.
# The scripts still write these locally; they are never committed.
research/annotation/tasks/*/images/
paper/figures/fig_demo.jpg
paper/figures/fig_qualitative.png
results/edge/demo/snapshot.jpg
results/figures/06_qualitative_test.png
results/figures/12_crowd_analytics_*.png
results/revision/bench_desktop_vlm_frame.jpg
results/revision/vlm_safety_frames/
results/test1/audit/*.jpg
results/test1/figures/01_qualitative.png
results/test1/figures/05_analytics.png

# ---------------------------------------------------------------------------
# LaTeX build artefacts (main.pdf is kept)
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
paper/*.log
paper/build.log

